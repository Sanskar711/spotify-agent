# ---- Server ----
PORT=8000
# Comma-separated allowed origins (your frontend). No trailing slash.
FRONTEND_URL=http://localhost:5173

# ---- Spotify OAuth (https://developer.spotify.com/dashboard) ----
CLIENT_ID=your_spotify_client_id
CLIENT_SECRET=your_spotify_client_secret
# Must EXACTLY match a Redirect URI registered in the Spotify dashboard:
REDIRECT_URI=http://localhost:8000/auth/callback

# ---- Security ----
# Any long random strings. e.g. `openssl rand -hex 32`
JWT_SECRET=change_me_long_random
ENCRYPTION_KEY=change_me_long_random

# ---- Supabase (service role key — server only, keep secret) ----
# Bare project URL only — do NOT append /rest/v1, the client adds it.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ---- Debugging ----
# Show the underlying OAuth failure on the login page instead of a generic message.
DEBUG_AUTH_ERRORS=false

# ---- Shazam-like recognition (https://audd.io) ----
AUDD_API_TOKEN=your_audd_token

# ---- LLM providers (optional server-side fallback keys) ----
# Users can bring their own key in-app; these are only used if a user has none.
DEFAULT_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
